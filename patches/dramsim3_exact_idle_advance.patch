+bool JedecDRAMSystem::IsIdle() const {
+    return std::all_of(ctrls_.begin(), ctrls_.end(),
+                       [](const Controller* controller) {
+                           return controller->CanAdvanceIdle();
+                       });
+}
+
+void JedecDRAMSystem::AdvanceIdle(uint64_t cycles) {
+    while (cycles > 0) {
+        if (!IsIdle()) {
+            ClockTick();
+            --cycles;
+            continue;
+        }
+        uint64_t step = cycles;
+        for (const Controller* controller : ctrls_) {
+            step = std::min(step, controller->ClocksUntilRefresh());
+        }
+        const uint64_t epoch_remainder = clk_ % config_.epoch_period;
+        const uint64_t until_epoch =
+            epoch_remainder == 0 ? config_.epoch_period
+                                 : config_.epoch_period - epoch_remainder;
+        step = std::min(step, until_epoch);
+        if (step == 0) {
+            ClockTick();
+            --cycles;
+            continue;
+        }
+        for (Controller* controller : ctrls_) {
+            controller->AdvanceIdle(step);
+        }
+        clk_ += step;
+        cycles -= step;
+        if (clk_ % config_.epoch_period == 0) {
+            PrintEpochStats();
+        }
+    }
+}

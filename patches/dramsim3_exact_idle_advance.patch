+bool Controller::CanAdvanceIdle() const {
+    const bool deferred_writes_stable =
+        !is_unified_queue_ && write_draining_ == 0 &&
+        write_buffer_.size() <= 8 &&
+        pending_wr_q_.size() == write_buffer_.size();
+    if (config_.enable_self_refresh || !unified_queue_.empty() ||
+        !read_queue_.empty() ||
+        (!write_buffer_.empty() && !deferred_writes_stable) ||
+        !pending_rd_q_.empty() ||
+        (!pending_wr_q_.empty() && !deferred_writes_stable) ||
+        !return_queue_.empty() || !cmd_queue_.QueueEmpty() ||
+        channel_state_.IsRefreshWaiting()) {
+        return false;
+    }
+    for (int rank = 0; rank < config_.ranks; ++rank) {
+        if (channel_state_.IsRankSelfRefreshing(rank)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+uint64_t Controller::ClocksUntilRefresh() const {
+    return refresh_.ClocksUntilRefresh();
+}
+
+void Controller::AdvanceIdle(uint64_t cycles) {
+    assert(CanAdvanceIdle());
+    assert(cycles > 0 && cycles <= ClocksUntilRefresh());
+    for (int rank = 0; rank < config_.ranks; ++rank) {
+        if (channel_state_.IsAllBankIdleInRank(rank)) {
+            simple_stats_.IncrementVecBy("all_bank_idle_cycles", rank, cycles);
+            channel_state_.rank_idle_cycles[rank] += static_cast<int>(cycles);
+        } else {
+            simple_stats_.IncrementVecBy("rank_active_cycles", rank, cycles);
+            channel_state_.rank_idle_cycles[rank] = 0;
+        }
+    }
+    clk_ += cycles;
+    cmd_queue_.AdvanceIdle(cycles);
+    refresh_.AdvanceIdle(cycles);
+    simple_stats_.IncrementBy("num_cycles", cycles);
+}

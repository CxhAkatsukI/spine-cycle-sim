+uint64_t ChannelState::NextReadyClock(const Command& cmd) const {
+    if (cmd.IsRankCMD()) {
+        uint64_t target_ready = 0;
+        uint64_t prerequisite_ready = std::numeric_limits<uint64_t>::max();
+        bool all_target = true;
+        for (auto j = 0; j < config_.bankgroups; j++) {
+            for (auto k = 0; k < config_.banks_per_group; k++) {
+                const BankState& bank = bank_states_[cmd.Rank()][j][k];
+                const Command required = bank.RequiredCommand(cmd);
+                if (!required.IsValid()) {
+                    return std::numeric_limits<uint64_t>::max();
+                }
+                const uint64_t ready = bank.ReadyClock(required.cmd_type);
+                if (required.cmd_type == cmd.cmd_type) {
+                    target_ready = std::max(target_ready, ready);
+                } else {
+                    all_target = false;
+                    prerequisite_ready = std::min(prerequisite_ready, ready);
+                }
+            }
+        }
+        return all_target ? target_ready : prerequisite_ready;
+    }
+
+    const BankState& bank =
+        bank_states_[cmd.Rank()][cmd.Bankgroup()][cmd.Bank()];
+    const Command required = bank.RequiredCommand(cmd);
+    if (!required.IsValid()) {
+        return std::numeric_limits<uint64_t>::max();
+    }
+    uint64_t ready = bank.ReadyClock(required.cmd_type);
+    if (required.cmd_type == CommandType::ACTIVATE) {
+        ready = std::max(ready, ActivationReadyClock(required.Rank()));
+    }
+    return ready;
+}

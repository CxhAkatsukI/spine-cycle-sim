  "replay_command": [
    "/usr/bin/python3",
    "-c",
    "import json, os, subprocess, sys, time\nfrom pathlib import Path\nfrom spine_cycle_sim.experiments.original_regraph_execution.hardware.source_retention import active_min_admission as admission, active_min_resident as resident, cc_warm_matrix as warm, cc_resident_wall as wall, spine_cc_layout as layout\nfrom spine_cycle_sim.experiments.original_regraph_execution.hardware.source_retention.runtime import identity, save\nfrom spine_cycle_sim.experiments.original_regraph_execution.hardware.source_retention.follow import unchanged\nfrom spine_cycle_sim.experiments.sharded_k4_stages.row_line.directory_tile.hardware import containment\nroot = Path(\"/data/chuxiao/checks/source-retention-repair-20261104\")\nout = root / \"cc-warm-matrix-offline-replay-20261106-v1\"\nout.mkdir(exist_ok=False)\ngroup = containment.current()\nguard = containment.verify(group, 2)\nhandoff_path = root / \"cc-warm-matrix-control-fix-20261106-handoff.json\"\nhandoff_pin = identity(handoff_path)\nhandoff = json.loads(handoff_path.read_text())\nreplacement = handoff[\"replacement\"]\ncommand = replacement[\"command\"]\nindex = command.index(\"-m\")\nexpected = command[index-1:]\nactual = Path(\"/proc/3634236/cmdline\").read_bytes().decode().strip(\"\\0\").split(\"\\0\")\nif actual != expected:\n    raise ValueError(\"live matrix command no longer matches the retained launch\")\nsource = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip()\nif source != replacement[\"source_commit\"]:\n    raise ValueError(\"offline replay must use the exact live frozen matrix source\")\nif subprocess.check_output([\"git\", \"status\", \"--porcelain\"], text=True):\n    raise ValueError(\"frozen matrix source is dirty\")\nargs = resident.parse_arguments(command[index+2:], extend=warm.arguments)\nresult = dict(status=\"RUNNING\", source_commit=source, launch=handoff_pin, live_matrix_command=actual,\n              replay_command=Path(\"/proc/self/cmdline\").read_bytes().decode().strip(\"\\0\").split(\"\\0\"),\n              containment=guard, board_launch_attempted=False, new_performance_measurement=False,\n              route_admission_checked=False, route_pending=\"new Spine CC image, raw skew, AU correctness and wall comparison\",\n              layouts={})\njournal = out / \"results.json\"\nsave(journal, result)\nstart = time.monotonic()\ntry:\n    gate = admission.admit(args.algorithm, args.route, args.host, args.r_report, args.r_inputs,\n                            args.g_report, args.g_reference)\n    result[\"baseline\"] = gate\n    odd, odd_inputs, topology, topology_inputs = args.cc_warm_r_controls\n    pins = admission.pin_odd_queue(odd, odd_inputs, args.algorithm)\n    result[\"odd_queue_pins\"] = pins\n    controls = {name: admission.replay_r(path, \"cc\", inputs, gate[\"host\"], gate[\"image\"], geometry=geometry)\n                for name, path, inputs, geometry in (\n                    (\"amazon_odd\", odd, odd_inputs, admission.AMAZON_GEOMETRY),\n                    (\"au_slice\", topology, topology_inputs, admission.AU_SLICE_GEOMETRY))}\n    result[\"additional_r_gates\"] = controls\n    packet = json.loads(args.cc_wall_packet.read_text())\n    gr_host = identity(packet[\"gr_host\"])\n    if gr_host[\"sha256\"] != wall.GR_HOST:\n        raise ValueError(\"queued wall host differs from the qualified G+R wall binary\")\n    result[\"gr_wall_host\"] = gr_host\n    save(journal, result)\n    for dataset, receipt, inputs in args.layout:\n        receipt, inputs = Path(receipt), Path(inputs)\n        case, frozen = resident.frozen_case(args.previous, \"cc\", dataset)\n        old = json.loads(receipt.read_text())\n        host = old[\"host\"]\n        if host[\"sha256\"] != \"f16bb3c7cd69d461e4fd35ed2b2db3933f717a29e66f5984f5808ea4ac9622a1\":\n            raise ValueError(dataset + \": offline host differs from the retained-link host bytes\")\n        split = json.loads(inputs.read_text())\n        source_pin = next(pin for pin in frozen if pin[\"path\"] == case[\"graph\"])\n        if split[\"source\"] != source_pin or any(split[key] != case[key] for key in (\"vertices\", \"edges\", \"updates\")):\n            raise ValueError(dataset + \": split dimensions or source differ from frozen workload\")\n        counts, checked = layout.replay(receipt, dataset, host=host, inputs=inputs, frozen=source_pin)\n        unchanged(frozen + checked)\n        result[\"layouts\"][dataset] = dict(status=\"LAYOUT_REPLAY_PASS_NOT_FPGA\", counts=counts,\n                                            vertices=case[\"vertices\"], edges=case[\"edges\"], updates=case[\"updates\"],\n                                            pins=frozen + checked)\n        save(journal, result)\n        print(dataset + \": frozen source, split and layout replay passed\", flush=True)\n    if set(result[\"layouts\"]) != set(warm.DATASETS):\n        raise ValueError(\"replay did not cover every queued remaining dataset\")\n    unchanged([handoff_pin, *pins, gr_host])\n    result[\"status\"] = \"BASELINE_AND_SEVEN_LAYOUTS_REPLAY_PASS_NOT_FPGA\"\nexcept BaseException as error:\n    result.update(status=\"FAILED_RETAINED\", error=repr(error))\n    raise\nfinally:\n    result[\"elapsed_seconds\"] = time.monotonic() - start\n    result[\"memory_peak_bytes\"] = int((group / \"memory.peak\").read_text())\n    result[\"memory_events\"] = (group / \"memory.events\").read_text()\n    save(journal, result)\nprint(result[\"status\"], flush=True)\n"
  ],

@@ -208,6 +208,37 @@ public:
         compute_.setArg(2, owner_); compute_.setArg(3, result_); compute_.setArg(4, n_);
         run(SPINE_REPAIR_INIT, false, source); run(SPINE_REPAIR_INIT_REVERSE, true);
     }
+    void preload_graph_bank(int orientation, unsigned bank, const std::vector<uint64_t>& words) {
+        require(orientation >= 0 && orientation < 2 && bank < 16 &&
+                words.size() == partitioned_fixed_all_levels_words_host() * 2,
+                "invalid checkpoint graph bank extent");
+        transfer_.enqueueWriteBuffer(graph_[orientation][bank], CL_TRUE, 0,
+                                     words.size() * sizeof(words[0]), words.data());
+    }
+    void preload_graph_index(int orientation, const std::vector<uint64_t>& meta,
+                             const std::vector<PartitionedHbm16Word>& directory) {
+        require(orientation >= 0 && orientation < 2 && meta.size() == HOST_PARTITIONED_META_WORDS &&
+                directory.size() == HOST_PARTITIONED_FAMILY_DIRECTORY_WORDS &&
+                header(SR_PHASE) == SR_IDLE && !header(SR_GENERATION) && !header(SR_CONVERGED),
+                "checkpoint index can only be loaded after fresh INIT");
+        // Do not replace the authority and generation words set by device INIT.
+        transfer_.enqueueWriteBuffer(meta_[orientation], CL_TRUE, 0,
+                                     HOST_PARTITIONED_REPAIR_META_BASE * 8ULL, meta.data());
+        transfer_.enqueueWriteBuffer(input_[orientation], CL_TRUE,
+                                     HOST_PARTITIONED_FAMILY_DIRECTORY_OFFSET * 16ULL,
+                                     directory.size() * 16ULL, directory.data());
+    }
+    void preload_converged_distances(const std::vector<uint32_t>& distances) {
+        require(distances.size() == n_ && header(SR_PHASE) == SR_IDLE &&
+                !header(SR_GENERATION) && !header(SR_CONVERGED) &&
+                header(SR_INDEX_VALID) && header(SR_ACK_MASK) == 3 &&
+                distances.at(header(SR_SOURCE)) == 0, "invalid starting distance checkpoint");
+        require_quiescent();
+        transfer_.enqueueWriteBuffer(state_, CL_TRUE, 0, distances.size() * 4ULL, distances.data());
+        header_[SR_CONVERGED].word[0] = 1;
+        transfer_.enqueueWriteBuffer(workspace_, CL_TRUE, SR_CONVERGED * sizeof(header_[0]),
+                                     sizeof(header_[0]), &header_[SR_CONVERGED]);
+    }
     uint64_t header(int field) const {
         return uint64_t(header_[field].word[0]) | (uint64_t(header_[field].word[1]) << 32);
     }

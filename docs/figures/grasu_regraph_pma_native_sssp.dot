digraph grasu_regraph_pma_native_sssp {
  graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.3", ranksep="0.6"];
  node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#4a4a4a", fontname="DejaVu Sans", fontsize=10];
  edge [color="#555555", fontname="DejaVu Sans", fontsize=9];

  update [label="GraSU update system\n4 search CUs + dispatch\ncache / DDR PMA RMW", fillcolor="#dfeaf4"];
  barrier [label="Completion barrier\nserial baseline", shape=diamond, fillcolor="#fff3cd"];
  pma [label="Payload-backed PMA\n4 HBM images\n16 destinations / 64 B", shape=cylinder, fillcolor="#e8e8e8"];
  rows [label="Row bounds\n8 B / source", shape=cylinder, fillcolor="#e8e8e8"];
  apply_state [label="Apply-local state\nactive bit + distance\nHBM channel 30", shape=cylinder, fillcolor="#e8e8e8"];
  source_state [label="Ping-pong source state\nidentical copies\nHBM channels 1 and 3", shape=cylinder, fillcolor="#e8e8e8"];
  source_cache [label="Ping-pong source cache\n4096 words / fixed window\nfinite request / response", fillcolor="#dcebd9"];
  reader [label="PMA-native reader\nrow AXI + 4 PMA AXI ports\nscan reserved empty slots", fillcolor="#dcebd9"];
  axis [label="Registered AXIS FIFO\n4 or 8 slots / batch\nfinite depth", fillcolor="#f4e1c1"];
  reset [label="Gather reset sweep\n65536 / 2 cycles", fillcolor="#f0d9e7"];
  gather [label="4/8 lane-local banks\nunit-weight SSSP\nL+1 RAW forwarding", fillcolor="#f0d9e7"];
  merge [label="Gather output / clear\n64-bit row per cycle\n32768 rows / partition", fillcolor="#f0d9e7"];
  pack [label="Free-running little merger\npack 8 x 64-bit rows\ninto one 512-bit burst", fillcolor="#f4e1c1"];
  apply [label="Partition-wide apply\n64 B read + write bursts\nset next active bits", fillcolor="#d9e8f5"];
  hbm_wrapper [label="HBM write wrapper\nII=1, iteration latency 71\nmirror each 512-bit result", fillcolor="#d9e8f5"];
  oracle [label="Committed-state\ndistance oracle + byte/stall ledger", fillcolor="#dcebd9"];
  bypass [label="6-stage RAW bypass registers\nII=1, iteration latency 9", fillcolor="#fff3cd", color="#9a7800"];

  update -> pma [label="committed updates"];
  update -> barrier;
  barrier -> reader;
  pma -> reader [label="64 B AXI responses"];
  rows -> reader [label="8 B AXI responses"];
  source_state -> source_cache [label="next-round AXI reads"];
  source_cache -> reader [label="active + source payload"];
  reader -> axis [label="16 / lanes batches per segment"];
  reset -> gather [label="round start"];
  axis -> gather [label="backpressure"];
  gather -> merge;
  merge -> pack [label="AXIS depth 16"];
  pack -> apply [label="AXIS depth 16"];
  apply_state -> apply [dir=both, label="64 B AXI R/W"];
  apply -> hbm_wrapper [label="512-bit AXIS, depth 16"];
  hbm_wrapper -> source_state [label="two parallel 64 B writes", color="#3f7f5f"];
  apply -> oracle [label="no active vertices"];
  bypass -> gather;
}

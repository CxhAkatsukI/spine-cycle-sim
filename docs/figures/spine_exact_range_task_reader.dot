digraph SpineExactRangeTaskReader {
  graph [rankdir=TB, bgcolor="#FAFAF8", pad="0.25", nodesep="0.34", ranksep="0.58", splines=ortho, compound=true, newrank=true, fontname="DejaVu Sans", label="Spine payload-authoritative exact range-task reader", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#59636E", fontname="DejaVu Sans", fontsize=10, margin="0.14,0.09"];
  edge [color="#59636E", fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];

  subgraph cluster_frontier {
    label="Payload-authoritative frontier"; color="#557A66"; style="rounded,filled"; fillcolor="#EDF5F0";
    control [label="HBM metadata control\nmagic | version | features"];
    dirty_meta [label="DEVICE_DIRTY metadata\ncount | generation | sum/xor hash"];
    dirty_hbm [label="HBM16 dirty list + bitmap\nvalidate range, hash, membership"];
    source_axis [label="Source-value AXIS protocol\n16-request windows\ncount | generation | done | ACK"];
    active_meta [label="HOST_ACTIVE metadata\n16 offsets + 16 counts"];
    active_hbm [label="active_bins HBM\n256-bit records"];
    decode [label="Decoded active record\nsrc | value | 11 level masks | hot mask"];
    control -> dirty_meta -> dirty_hbm -> source_axis -> decode;
    control -> active_meta -> active_hbm -> decode;
  }

  subgraph cluster_metadata {
    label="HBM level metadata and exact row lookup"; color="#426B8A"; style="rounded,filled"; fillcolor="#EAF2F8";
    occupancy [label="32 families x 11 levels\noccupied word first"];
    level_cache [label="Occupied slice payload\nedge/row counts + five offsets + slice epoch"];
    epoch [label="Page epoch payload\nmust equal slice epoch"];
    bitmap [label="selected bitmap word\nmiss stops lookup"];
    rank [label="earlier bitmap words\npopcount rank"];
    pagebase [label="packed page-base word"];
    rowoffset [label="packed row offsets\n[start, end)"];
    occupancy -> level_cache -> epoch -> bitmap -> rank -> pagebase -> rowoffset;
  }

  subgraph cluster_construct {
    label="Descriptor construction"; color="#8A5B45"; style="rounded,filled"; fillcolor="#FAF0EB";
    read1 [label="HBM edge payload scan #1\nvalidate dst ordering/partition"];
    runs [label="Split contiguous runs\nby global 64K-vertex tile"];
    desc [label="128-bit range descriptors\nstart | length | value | tile | bank | flags | src"];
    read1 -> runs -> desc;
  }

  subgraph cluster_bin {
    label="Task scratch and tile binning"; color="#765C8A"; style="rounded,filled"; fillcolor="#F3EEF7";
    clear [label="256-cycle tile-state clear\nBRAM-shaped"];
    unsorted [label="Unsorted descriptor cache\nURAM-shaped"];
    prefix [label="256-cycle prefix"];
    scatter [label="1 cycle / descriptor scatter"];
    verify [label="256-cycle cursor verify"];
    binned [label="Per-tile binned descriptors"];
    clear -> prefix;
    unsorted -> prefix -> scatter -> verify -> binned;
  }

  subgraph cluster_replay {
    label="Tile replay and compute handoff"; color="#9B7A25"; style="rounded,filled"; fillcolor="#FFF7DF";
    tileloop [label="Scan 256 tile bins"];
    read2 [label="HBM edge payload scan #2\nvalidate expected tile"];
    axis [label="Finite PartConv AXIS FIFO\nTILE_BEGIN | EDGE | TILE_END | DONE"];
    compute [label="Spine compute CU\ntiny/full tile path"];
    tileloop -> read2 -> axis -> compute;
  }

  decode -> occupancy [label="source + masks"];
  bitmap -> read1 [label="row hit", lhead=cluster_construct];
  rowoffset -> read1 [label="exact range"];
  desc -> unsorted;
  binned -> tileloop;

  protocol_gap [label="Remaining protocol/timing gaps\ndiagnostics + dirty ownership ACK\nfallback execution + pipelined AXI\nURAM/BRAM bank conflicts", color="#A86A45", fillcolor="#FFF3E8", style="rounded,filled,dashed"];
  protocol_gap -> source_axis [style=dashed, arrowhead=none];
  protocol_gap -> unsorted [style=dashed, arrowhead=none];
}

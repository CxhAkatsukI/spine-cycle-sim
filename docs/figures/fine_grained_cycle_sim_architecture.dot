digraph FineGrainedCycleSimulator {
  graph [rankdir=LR, bgcolor="#FAFAF8", pad="0.25", nodesep="0.35", ranksep="0.65", splines=ortho, compound=true, fontname="DejaVu Sans", label="Fine-grained execution-driven graph accelerator simulator", labelloc=t, fontsize=20];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#59636E", fontname="DejaVu Sans", fontsize=10, margin="0.14,0.09"];
  edge [color="#59636E", fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];

  subgraph cluster_python {
    label="Python experiment layer"; color="#557A66"; style="rounded,filled"; fillcolor="#EDF5F0";
    graph_input [label="Real graph + update batches"];
    profiles [label="Versioned architecture profiles [implemented]\nmeasured / normalized / projected"];
    policies [label="Algorithm policies [functional implemented]\nSSSP | Full PR | Residual PR\ncycle-core connection planned"];
    orchestration [label="Run matrix + result manifest"];
    math_oracle [label="High-precision oracle"];
    bit_oracle [label="Bit-accurate oracle"];
    graph_input -> orchestration;
    profiles -> orchestration;
    policies -> orchestration;
  }

  subgraph cluster_cpp {
    label="Shared C++ cycle core"; color="#426B8A"; style="rounded,filled"; fillcolor="#EAF2F8";
    scheduler [label="Absolute-time multi-clock scheduler [implemented]\nall prepare -> all evaluate -> all commit"];
    fifo [label="Finite FIFO [implemented]\nregistered transfer + backpressure"];
    onchip [label="Banked BRAM / URAM [implemented]\nports + latency + conflicts"];
    axi [label="AXI masters [implemented]\nfixed channel + initiator-isolated responses\nbursts + beats + outstanding"];
    scheduler -> fifo [dir=both];
    scheduler -> onchip [dir=both];
    scheduler -> axi [dir=both];
  }

  subgraph cluster_arch {
    label="Independent accelerator architectures"; color="#8A5B45"; style="rounded,filled"; fillcolor="#FAF0EB";
    spine [label="Spine [online SST carry/hot/full-tile slices implemented]\ncold/hot 16x11 levels -> all-level reader -> AXIS(32) -> tiny/full SSSP\nrepeated convergence planned"];
    grasu [label="GraSU [planned]\nPMA update engine"];
    native_handoff [label="PMA-native device handoff\n(projected until synthesized)"];
    regraph [label="ReGraph [planned]\nMap/Reduce/Apply compute"];
    grasu -> native_handoff -> regraph;
  }

  subgraph cluster_memory {
    label="Interchangeable memory backend"; color="#9B7A25"; style="rounded,filled"; fillcolor="#FFF7DF";
    memif [label="Online request/response interface\nindependent HBM clock"];
    mock [label="Deterministic MockMemory [implemented]\nunit tests only"];
    sst [label="SST memHierarchy + DRAMSim3/HBM [implemented]\nonline formal backend adapter"];
    memif -> mock [style=dashed];
    memif -> sst;
  }

  subgraph cluster_evidence {
    label="Evidence and claims gate"; color="#765C8A"; style="rounded,filled"; fillcolor="#F3EEF7";
    counters [label="Cycle + structural + activity counters"];
    validation [label="Dual-oracle correctness\nHW calibration / holdout"];
    energy [label="CACTI + FPGA/ASIC synthesis\narea | timing | energy"];
    report [label="Native / normalized / projected reports"];
    counters -> validation -> report;
    counters -> energy -> report;
  }

  orchestration -> scheduler [label="configuration + workload"];
  policies -> spine [style=dashed];
  policies -> regraph [style=dashed];
  fifo -> spine [dir=both];
  onchip -> spine [dir=both];
  fifo -> grasu [dir=both];
  onchip -> regraph [dir=both];
  axi -> memif [dir=both];
  spine -> axi [dir=both];
  grasu -> axi [dir=both];
  regraph -> axi [dir=both];
  scheduler -> counters;
  spine -> counters [style=dashed];
  grasu -> counters [style=dashed];
  regraph -> counters [style=dashed];
  orchestration -> math_oracle [style=dashed];
  orchestration -> bit_oracle [style=dashed];
  math_oracle -> validation;
  bit_oracle -> validation;
}

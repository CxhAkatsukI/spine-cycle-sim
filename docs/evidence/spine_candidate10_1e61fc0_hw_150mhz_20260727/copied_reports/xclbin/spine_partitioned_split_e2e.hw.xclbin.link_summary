   "-O3",
   "--config",
   "/data/feiyang/spine-dynamic-graph-builds/pipeline_dirty_frontier_publication_1e61fc0_20260725/production/hw_v5_candidate10_150/system_partitioned_split_e2e.cfg",
   "--temp_dir",

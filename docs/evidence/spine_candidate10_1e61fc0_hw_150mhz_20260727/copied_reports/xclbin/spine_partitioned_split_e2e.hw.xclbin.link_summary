   "/data/feiyang/spine-dynamic-graph-builds/pipeline_dirty_frontier_publication_1e61fc0_20260725/production/hw_v5_candidate10_150/xclbin/spine_partitioned_split_e2e.hw.xclbin",
   "/data/feiyang/spine-dynamic-graph-builds/pipeline_dirty_frontier_publication_1e61fc0_20260725/production/hls_v5_candidate_10/spine_partconv_rdmaint_kernel.hw.xo",
   "/data/feiyang/spine-dynamic-graph-builds/pipeline_dirty_frontier_publication_1e61fc0_20260725/baseline/evidence/hw_exact_150_bitmap_prefetch_v14/xclbin/spine_partconv_compute_kernel.hw.xo"
  ],
  "iniFiles": [
   {
    "path": "/data/feiyang/spine-dynamic-graph-builds/pipeline_dirty_frontier_publication_1e61fc0_20260725/production/hw_v5_candidate10_150/system_partitioned_split_e2e.cfg",
    "content": "[connectivity]\n# Parallel-variant split build of the partitioned-e2e convergence path.\n# TWO CUs: a mode-muxed readmaint (maintenance + edge-reader) on SLR0, local to\n# HBM, and compute on SLR1. Maintenance and edge-reads are FUSED into one CU so\n# they SHARE the 16 graphN masters -- a 3-CU split (maint 19 + reader 18 + compute\n# 4 = 41 masters) overflows the hmss_0 33-AXI-master hard limit because maint and\n# reader would each carry their own 16 graphN masters. Fused readmaint = 20 masters;\n# with compute's 4 the topology totals 24 \u003c= 33 and still leaves exactly 4 masters\n# on SLR1 (the whole point: relieve SLR1 routing/SLL).\n# The muxed spine_partitioned_e2e_kernel / system_partitioned_e2e.cfg build is left\n# byte-for-byte untouched as the fallback; this cfg is only linked by the\n# spine_partitioned_split_e2e.$(TARGET).xclbin target.\nnk=spine_partconv_rdmaint_kernel:1\nnk=spine_partconv_compute_kernel:1\n\n# One narrow 64-bit AXIS carries (dst, proposed) records + TILE_BEGIN/END/DONE_ALL\n# markers across the SLR0-\u003eSLR1 seam, replacing the 18-master wide read crossing.\n# Written only in CONV mode; MAINT mode leaves it idle (compute is co-enqueued only\n# for CONV).\n# sw_emu observed a maximum occupancy of 14 records on the 2-CU topology. A\n# depth of 32 preserves more than 2x headroom while avoiding a large cross-SLR\n# FIFO implementation.\nstream_connect=spine_partconv_rdmaint_kernel_1.edge_out:spine_partconv_compute_kernel_1.edge_in:32\nstream_connect=spine_partconv_compute_kernel_1.value_out:spine_partconv_rdmaint_kernel_1.value_in:32\n\n# Maintenance + edge reads sit on SLR0 with HBM (matches the proven system.cfg\n# sibling: maintenance+reader local to HBM). Only the compute + its 4 unavoidable\n# state/output masters remain on SLR1.\nslr=spine_partconv_rdmaint_kernel_1:SLR0\nslr=spine_partconv_compute_kernel_1:SLR1\n\n# --- Readmaint CU (SLR0): 16 graph banks + sorted_edges (MAINT) + active_bins\n#     (CONV) + meta + result_out (MAINT). 20 masters total. ---\nsp=spine_partconv_rdmaint_kernel_1.graph0:HBM[0]\nsp=spine_partconv_rdmaint_kernel_1.graph1:HBM[1]\nsp=spine_partconv_rdmaint_kernel_1.graph2:HBM[2]\nsp=spine_partconv_rdmaint_kernel_1.graph3:HBM[3]\nsp=spine_partconv_rdmaint_kernel_1.graph4:HBM[4]\nsp=spine_partconv_rdmaint_kernel_1.graph5:HBM[5]\nsp=spine_partconv_rdmaint_kernel_1.graph6:HBM[6]\nsp=spine_partconv_rdmaint_kernel_1.graph7:HBM[7]\nsp=spine_partconv_rdmaint_kernel_1.graph8:HBM[8]\nsp=spine_partconv_rdmaint_kernel_1.graph9:HBM[9]\nsp=spine_partconv_rdmaint_kernel_1.graph10:HBM[10]\nsp=spine_partconv_rdmaint_kernel_1.graph11:HBM[11]\nsp=spine_partconv_rdmaint_kernel_1.graph12:HBM[12]\nsp=spine_partconv_rdmaint_kernel_1.graph13:HBM[13]\nsp=spine_partconv_rdmaint_kernel_1.graph14:HBM[14]\nsp=spine_partconv_rdmaint_kernel_1.graph15:HBM[15]\nsp=spine_partconv_rdmaint_kernel_1.sorted_edges:HBM[16]\nsp=spine_partconv_rdmaint_kernel_1.active_bins:HBM[18]\nsp=spine_partconv_rdmaint_kernel_1.level_meta_io:HBM[20]\nsp=spine_partconv_rdmaint_kernel_1.result_out:HBM[21]\n\n# --- Compute CU (SLR1): the 4 state/output masters that cannot be shed ---\nsp=spine_partconv_compute_kernel_1.vertex_state_hbm:HBM[17]\nsp=spine_partconv_compute_kernel_1.active_out_hbm:HBM[19]\nsp=spine_partconv_compute_kernel_1.result_out:HBM[21]\nsp=spine_partconv_compute_kernel_1.active_bitmap_hbm:HBM[22]\n\n[vivado]\nprop=run.impl_1.STEPS.PLACE_DESIGN.ARGS.DIRECTIVE=AltSpreadLogic_high\nprop=run.impl_1.STEPS.PHYS_OPT_DESIGN.ARGS.DIRECTIVE=AggressiveExplore\nprop=run.impl_1.STEPS.ROUTE_DESIGN.ARGS.DIRECTIVE=AlternateCLBRouting\nprop=run.impl_1.STEPS.POST_ROUTE_PHYS_OPT_DESIGN.ARGS.DIRECTIVE=AggressiveExplore\n"
   }
  ],
  "cwd": "/home/feiyang/dev_space/spine-dynamic-graph"
 }
}
